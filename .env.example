# Core
PORT=8787
NODE_ENV=development
APP_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-32-byte-random-hex
ADMIN_TOKEN=replace-with-a-long-random-admin-token
SEED_DEMO=false
DEMO_MODE=false

# GitHub metadata (optional: raises public API limits; README verification uses raw.githubusercontent.com)
GITHUB_TOKEN=

# Optional AI summarisation. Without this, GitFi uses its local README extraction model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database
# Use a remote Turso database in production. If omitted, a local SQLite file is used.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# NEAR testnet Repo Registry (deployed)
NEAR_NETWORK=testnet
NEAR_CONTRACT_ID=registry.gitfi-395012.testnet
NEAR_MARKET_CONTRACT_ID=market.gitfi-395012.testnet
NEAR_ORACLE_ACCOUNT_ID=gitfi-395012.testnet
ORACLE_SEED_HEX=
TEAM_ADDRESS=gitfi-395012.testnet
LAUNCH_FEE_YOCTO=1000000000000000000000000
NEAR_CHAIN_ENABLED=true
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_EXPLORER_URL=https://explorer.testnet.near.org
# Optional Worker RPC relay (avoids shared cloud IP rate limits)
NEAR_RPC_PROXY_URL=
NEAR_RPC_PROXY_TOKEN=
# Logo pinning (optional; local data URLs always work)
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
# Optional NEP-413 recipient shown in wallet prompts. Defaults to the APP_URL host.
# NEAR_AUTH_RECIPIENT=gitfi.fun
# Optional: override the credential file path or provide a secret key directly.
# NEAR_CREDENTIALS_DIR=C:\Users\you\.near-credentials
# NEAR_ORACLE_PRIVATE_KEY=ed25519:...

# Fraction of platform fees recycled into holder dividends (basis points of platform fee).
PLATFORM_YIELD_SHARE_BPS=4000
